{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "operatorCidr": {
      "type": "string",
      "metadata": {
        "description": "Operator public IPv4 /32 only; validate before deployment."
      }
    },
    "sshPublicKey": {
      "type": "string",
      "metadata": {
        "description": "Dedicated trial SSH public key. Never supply a private key."
      }
    },
    "expiresUtc": {
      "type": "string",
      "metadata": {
        "description": "Cleanup deadline tag only, not automatic deletion."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "vnet-aisdlc-trial",
      "location": "[resourceGroup().location]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.77.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "client",
            "properties": {
              "addressPrefix": "10.77.1.0/24",
              "defaultOutboundAccess": false
            }
          },
          {
            "name": "tools",
            "properties": {
              "addressPrefix": "10.77.2.0/24",
              "defaultOutboundAccess": false
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "nsg-aisdlc-client",
      "location": "[resourceGroup().location]",
      "properties": {
        "securityRules": [
          {
            "name": "operator-ssh",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[parameters('operatorCidr')]",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "22"
            }
          },
          {
            "name": "deny-other-inbound",
            "properties": {
              "priority": 200,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*"
            }
          },
          {
            "name": "bootstrap-http",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationPortRange": "80"
            }
          },
          {
            "name": "bootstrap-https",
            "properties": {
              "priority": 110,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationPortRange": "443"
            }
          },
          {
            "name": "deny-other-outbound",
            "properties": {
              "priority": 200,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "pip-aisdlc-client",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "nic-aisdlc-client",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-aisdlc-trial')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-aisdlc-client')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-aisdlc-client')]"
      ],
      "properties": {
        "enableIPForwarding": false,
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-aisdlc-client')]"
        },
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet-aisdlc-trial', 'client')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-aisdlc-client')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "vm-aisdlc-client",
      "location": "[resourceGroup().location]",
      "tags": {
        "purpose": "codex-isolation-feasibility",
        "role": "client",
        "execution": "disabled",
        "expiresUtc": "[parameters('expiresUtc')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-aisdlc-client')]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2als_v2"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "name": "disk-aisdlc-client",
            "createOption": "FromImage",
            "deleteOption": "Delete",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "diskSizeGB": 32
          }
        },
        "osProfile": {
          "computerName": "aisdlc-client",
          "adminUsername": "trialadmin",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/trialadmin/.ssh/authorized_keys",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-aisdlc-client')]",
              "properties": {
                "primary": true,
                "deleteOption": "Delete"
              }
            }
          ]
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "nsg-aisdlc-tools",
      "location": "[resourceGroup().location]",
      "properties": {
        "securityRules": [
          {
            "name": "operator-ssh",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[parameters('operatorCidr')]",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "22"
            }
          },
          {
            "name": "deny-other-inbound",
            "properties": {
              "priority": 200,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*"
            }
          },
          {
            "name": "bootstrap-http",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationPortRange": "80"
            }
          },
          {
            "name": "bootstrap-https",
            "properties": {
              "priority": 110,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationPortRange": "443"
            }
          },
          {
            "name": "deny-other-outbound",
            "properties": {
              "priority": 200,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "pip-aisdlc-tools",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "nic-aisdlc-tools",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'vnet-aisdlc-trial')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-aisdlc-tools')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-aisdlc-tools')]"
      ],
      "properties": {
        "enableIPForwarding": false,
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-aisdlc-tools')]"
        },
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet-aisdlc-trial', 'tools')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-aisdlc-tools')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "vm-aisdlc-tools",
      "location": "[resourceGroup().location]",
      "tags": {
        "purpose": "codex-isolation-feasibility",
        "role": "tools",
        "execution": "disabled",
        "expiresUtc": "[parameters('expiresUtc')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-aisdlc-tools')]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2als_v2"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "name": "disk-aisdlc-tools",
            "createOption": "FromImage",
            "deleteOption": "Delete",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "diskSizeGB": 32
          }
        },
        "osProfile": {
          "computerName": "aisdlc-tools",
          "adminUsername": "trialadmin",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/trialadmin/.ssh/authorized_keys",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-aisdlc-tools')]",
              "properties": {
                "primary": true,
                "deleteOption": "Delete"
              }
            }
          ]
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        }
      }
    }
  ]
}
